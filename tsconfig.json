{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": false,
		"esModuleInterop": true
	},
	"include": ["*.ts", "commands/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
