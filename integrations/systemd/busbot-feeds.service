# Refreshes every agency's schedule (npm run feeds), then restarts the BusBot
# API so it loads the new data. Driven by busbot-feeds.timer.
#
# Adjust User, the paths, and PATH (run `dirname $(which node)` for the node
# directory, e.g. under ~/.nvm) to match your install. If you run BusBot with
# its own radio instead of the API, change busbot-api to that service's name.
[Unit]
Description=Refresh BusBot transit schedules
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dragon
WorkingDirectory=/home/dragon/BusBot
Environment=PATH=/home/dragon/.nvm/versions/node/v24.12.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/dragon/BusBot/node_modules/.bin/tsx scripts/update_feeds.ts
# "+" runs just this step with root rights; it only runs if the refresh succeeded
ExecStartPost=+/bin/systemctl restart busbot-api
