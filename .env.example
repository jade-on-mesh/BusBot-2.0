SERIAL_PORT=/dev/cu.usbserial-0001
NODE_NAME="BusBot (en) 🚎"
BOT_CHANNEL="#transit"
LANGUAGE_CODE="en"
TIMEZONE="America/Los_Angeles"

# Agencies, their schedule downloads and live-data feeds are listed in
# feeds.json. Download/refresh them all with: npm run feeds
# FEEDS limits which agencies load (comma separated ids from feeds.json):
#FEEDS=kcm,st,ct,pt,et,it,kt,wsf,mono

# Optional: OneBusAway Puget Sound. When set, used first for arrivals and alerts,
# with GTFS-RT + schedule as the fallback. Request a key from oba_api_key@soundtransit.org
OBA_API_KEY=
#OBA_API_URL=https://api.pugetsound.onebusaway.org
#OBA_AGENCY_ID=1

# Contacts: companions kept on the radio before the least recently active is evicted.
# Set a little below your radio's contact limit.
MAX_CONTACTS=90

# Moderation. Comma separated. ADMIN_KEYS are public keys (or 6+ hex char prefixes)
# allowed to DM block/unblock/blocklist. BLOCKED_* are always blocked in addition
# to anything added with the block command.
ADMIN_KEYS=
BLOCKED_NAMES=
BLOCKED_KEYS=

# Emoji in replies (default on). Set to off for plain text, e.g. if riders on
# standalone radios see boxes instead of emoji.
EMOJI=on

# "stops" command: addresses and landmarks are looked up with OpenStreetMap
# Nominatim (limited to King County, max 1 request/second, cached). Cross-street
# searches never leave the Pi. GEOCODE=off disables address lookups.
GEOCODE=on
#GEOCODER_EMAIL=you@example.com
#GEOCODER_URL=https://nominatim.openstreetmap.org

# Quiet-channel alert posts: after ALERT_QUIET_MINUTES with no channel traffic,
# post one active service alert (most severe, then newest; no repeats within
# 24 h). None during ALERT_QUIET_HOURS (local, "22-6" = 10pm to 6am; "off" =
# any time). ALERT_POSTS=off disables.
ALERT_POSTS=on
ALERT_QUIET_MINUTES=60
ALERT_QUIET_HOURS=22-6
