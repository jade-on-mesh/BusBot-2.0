SERIAL_PORT=/dev/cu.usbserial-0001
NODE_NAME="BusBot (en) 🚎"
BOT_CHANNEL="#transit"
LANGUAGE_CODE="en"
TIMEZONE="America/Los_Angeles"

# King County Metro GTFS-RT (JSON) feeds
METRO_GTFS_RT_TRIP_UPDATES_FEED=https://s3.amazonaws.com/kcm-alerts-realtime-prod/tripupdates_enhanced.json
METRO_GTFS_RT_SERVICE_ALERTS_FEED=https://s3.amazonaws.com/kcm-alerts-realtime-prod/alerts_enhanced.json

# Optional: OneBusAway Puget Sound. When set, used first for arrivals and alerts,
# with GTFS-RT + schedule as the fallback. Request a key from oba_api_key@soundtransit.org
OBA_API_KEY=
#OBA_API_URL=https://api.pugetsound.onebusaway.org
#OBA_AGENCY_ID=1

# Contacts: companions kept on the radio before the least recently active is evicted.
# Set a little below your radio's contact limit.
MAX_CONTACTS=90

# Moderation. Comma separated. ADMIN_KEYS are public keys (or 6+ hex char prefixes)
# allowed to DM block/unblock/blocklist. BLOCKED_* are always blocked in addition
# to anything added with the block command.
ADMIN_KEYS=
BLOCKED_NAMES=
BLOCKED_KEYS=
